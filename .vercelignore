# ============================================================
# NWIS — Root Vercel Deployment Exclusions (.vercelignore)
# Excludes legacy backends, heavy data, and local artifacts.
# ============================================================

# Legacy / redundant backend directories
nwis-backend/
app/

# Local environments
venv/
.venv/
env/
__pycache__/
*.pyc

# All heavy data assets (Vercel Services will also apply
# per-service .vercelignore in NWIS_Integrated_Backend/)
NWIS_Integrated_Backend/data_sources/
NWIS_Integrated_Backend/uploads/*
!NWIS_Integrated_Backend/uploads/.gitkeep
NWIS_Integrated_Backend/tests/
NWIS_Integrated_Backend/scripts/
NWIS_Integrated_Backend/migrations/
NWIS_Integrated_Backend/.pytest_cache/

# Frontend build artifacts & dev files
NWIS_Frontend/node_modules/
NWIS_Frontend/dist/
NWIS_Frontend/Designs/
NWIS_Frontend/*.py

# Documentation & plans (not runtime)
*.md
!NWIS_Frontend/README.md
!NWIS_Integrated_Backend/README.md

# Generic temp files & heavy binary formats
.kilo/
.git/
.vscode/
.idea/
*.log
*.zip
*.tar.gz
*.xlsx
*.las
*.pdf
*.pkl
