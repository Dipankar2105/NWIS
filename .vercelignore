# ============================================================
# NWIS — Vercel Deployment Exclusions (.vercelignore)
# Excludes heavy raw datasets, virtualenvs, and local artifacts
# from entering the Vercel Serverless Function bundle.
# ============================================================

# Obsolete / Local virtual environment & backend backups
nwis-backend/
app/
venv/
.venv/
env/
__pycache__/
*.pyc

# Local data ingestion archives & heavy public datasets
NWIS_Integrated_Backend/data_sources/force2020/LAS_files_Force_2020_all_wells_train_test_blind_hidden_final.zip
NWIS_Integrated_Backend/data_sources/force2020/force2020_ingested_store.json
NWIS_Integrated_Backend/data_sources/force2020/extracted_las/
NWIS_Integrated_Backend/data_sources/
NWIS_Integrated_Backend/uploads/*
!NWIS_Integrated_Backend/uploads/.gitkeep
NWIS_Integrated_Backend/tests/
NWIS_Integrated_Backend/.pytest_cache/

# Local frontend build artifacts & node_modules
NWIS_Frontend/node_modules/
NWIS_Frontend/dist/
NWIS_Frontend/Designs/
NWIS_Frontend/*.py

# Generic temporary files & logs
.kilo/
.git/
.vscode/
.idea/
*.log
*.zip
*.tar.gz
*.xlsx
*.las
*.pdf
*.pkl
