# ============================================
# NWIS — Nearby Wells Intelligence System
# Backend Environment Configuration
# ============================================

# --- APPLICATION ---
APP_NAME=NWIS
APP_ENV=development
DEBUG=true
SECRET_KEY=your_secret_key_here
API_PREFIX=/api/v1
PORT=8000

# --- SUPABASE (Database + Auth + Storage) ---
# Add your real Supabase credentials when ready
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- GOOGLE GEMINI (LLM + Vision OCR) ---
# Get from: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- HUGGINGFACE (Inference Embeddings) ---
# Get from: https://huggingface.co/settings/tokens
HF_API_KEY=

# --- EMBEDDINGS CONFIGURATION ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_PROVIDER=hf_api

# --- BHASHINI (National Language Translation Mission) ---
# Get from: https://bhashini.gov.in / https://ulca.bhashini.gov.in
# Leave empty for development fallback mode
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_PIPELINE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# --- DATA.GOV.IN ---
# Get from: https://data.gov.in
DATA_GOV_API_KEY=

# --- API SETU ---
# Get from: https://apisetu.gov.in
APISETU_CLIENT_ID=
APISETU_CLIENT_SECRET=

# --- OCR CONFIG ---
OCR_PROVIDER=gemini_vision
OCR_LANGUAGES=en,hi
OCR_DPI=300
MAX_PAGES_PER_DOCUMENT=50

# --- RATE LIMITING ---
RATE_LIMIT_PER_MINUTE=30

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# --- FILE UPLOAD ---
MAX_UPLOAD_SIZE_MB=25
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,tiff
UPLOAD_DIR=./uploads

# --- ALERTS ---
ALERT_DEPTH_WINDOW_METERS=300
ALERT_RADIUS_KM=5.0
ALERT_MIN_PROBABILITY=0.4

# --- RISK PREDICTION ---
RISK_MODEL_PATH=./models/risk_model.pkl
RISK_TYPES=mud_loss,stuck_pipe,kick,overpressure,torque_spike,cement_issue
