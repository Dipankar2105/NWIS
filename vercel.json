{
  "version": 2,
  "builds": [
    {
      "src": "NWIS_Frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "NWIS_Integrated_Backend/**",
          "NWIS_Integrated_Backend/**/*"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/v1/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/health",
      "dest": "api/index.py"
    },
    {
      "src": "/docs",
      "dest": "api/index.py"
    },
    {
      "src": "/openapi.json",
      "dest": "api/index.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "NWIS_Frontend/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "NWIS_Frontend/$1"
    }
  ]
}

