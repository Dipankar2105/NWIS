# ============================================
# NWIS — Nearby Wells Intelligence System
# Backend Configuration
# ============================================

APP_NAME=NWIS
APP_ENV=development
DEBUG=true
SECRET_KEY=CHANGE_ME
API_PREFIX=/api/v1
PORT=8000

# --- SUPABASE ---
SUPABASE_URL=CHANGE_ME
SUPABASE_ANON_KEY=CHANGE_ME
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

# --- GOOGLE GEMINI ---
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-2.0-flash

# --- HUGGINGFACE ---
HF_API_KEY=CHANGE_ME

# --- EMBEDDINGS ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_PROVIDER=hf_api

# --- BHASHINI ---
BHASHINI_API_KEY=placeholder
BHASHINI_USER_ID=placeholder
BHASHINI_ULCA_API_KEY=placeholder

# --- DATA.GOV.IN ---
DATA_GOV_API_KEY=CHANGE_ME

# --- API SETU ---
APISETU_CLIENT_ID=placeholder
APISETU_CLIENT_SECRET=placeholder

# --- OCR ---
OCR_PROVIDER=gemini_vision
OCR_LANGUAGES=en,hi
OCR_DPI=300
MAX_PAGES_PER_DOCUMENT=50

# --- RATE LIMITING ---
RATE_LIMIT_PER_MINUTE=30

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# --- FILE UPLOAD ---
MAX_UPLOAD_SIZE_MB=25
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,tiff
UPLOAD_DIR=./uploads

# --- ALERTS ---
ALERT_DEPTH_WINDOW_METERS=300
ALERT_RADIUS_KM=5.0
ALERT_MIN_PROBABILITY=0.4

# --- RISK PREDICTION ---
RISK_MODEL_PATH=./models/risk_model.pkl
RISK_TYPES=mud_loss,stuck_pipe,kick,overpressure,torque_spike,cement_issue
