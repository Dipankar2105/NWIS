# ============================================================
# NWIS — NEARBY WELLS INTELLIGENCE SYSTEM
# COMPLETE PRODUCTION & DEPLOYMENT ENVIRONMENT CONFIGURATION
# ============================================================
#
# INSTRUCTIONS FOR VERCEL DEPLOYMENT:
# Add these variables under your Vercel Project -> Settings -> Environment Variables.
#
# DO NOT expose private secrets (SUPABASE_SERVICE_ROLE_KEY, GEMINI_API_KEY, SECRET_KEY)
# to frontend VITE_ variables!

# ------------------------------------------------------------
# 1. APPLICATION & SYSTEM CORE
# ------------------------------------------------------------
APP_NAME=NWIS
APP_ENV=production
DEBUG=false
SECRET_KEY=nwis_prod_secure_jwt_secret_key_change_me_987654321
API_PREFIX=/api/v1
PORT=8000

# ------------------------------------------------------------
# 2. FRONTEND PUBLIC ENVIRONMENT (VITE_)
# ------------------------------------------------------------
# In Vercel multi-service deployment, set VITE_API_BASE_URL to /api/v1
# (or leave empty to let frontend auto-detect same-origin routing)
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=NWIS
VITE_APP_VERSION=1.0.0

# ------------------------------------------------------------
# 3. SUPABASE (Database + Auth + Storage)
# ------------------------------------------------------------
# Get from: https://supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------
# 4. AI & EMBEDDINGS PROVIDERS
# ------------------------------------------------------------
# Google Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# HuggingFace API Token for BGE Embeddings (https://huggingface.co/settings/tokens)
HF_API_KEY=your_huggingface_api_key_here
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_PROVIDER=hf_api

# ------------------------------------------------------------
# 5. MULTILINGUAL & GOVERNMENT INTEGRATIONS
# ------------------------------------------------------------
# Bhashini National Language Translation Mission (https://bhashini.gov.in)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_PIPELINE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# Open Data & API Setu Govt Portals
DATA_GOV_API_KEY=
APISETU_CLIENT_ID=
APISETU_CLIENT_SECRET=

# ------------------------------------------------------------
# 6. CORS & NETWORK SECURITY
# ------------------------------------------------------------
# Comma-separated allowed origins (Vercel deployment domain + local dev origins)
CORS_ORIGINS=https://nwis.vercel.app,http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:8000

# ------------------------------------------------------------
# 7. DOCUMENT PROCESSING & HAZARD DETECTION ENGINE
# ------------------------------------------------------------
OCR_PROVIDER=gemini_vision
OCR_LANGUAGES=en,hi
OCR_DPI=300
MAX_PAGES_PER_DOCUMENT=50
MAX_UPLOAD_SIZE_MB=25
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,tiff
UPLOAD_DIR=./uploads

# Drilling Hazard Alerting Thresholds
ALERT_DEPTH_WINDOW_METERS=300
ALERT_RADIUS_KM=5.0
ALERT_MIN_PROBABILITY=0.4
RISK_MODEL_PATH=./models/risk_model.pkl
RISK_TYPES=mud_loss,stuck_pipe,kick,overpressure,torque_spike,cement_issue
